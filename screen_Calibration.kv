#:kivy 2.1.0

<ScreenCalibration>:
    MDBoxLayout:
        orientation: "vertical"

		# header layout
        MDBoxLayout:
            id: header_layout
            orientation: "horizontal"
            padding: 20
			spacing: 20
			size_hint_y: 0.2
			md_bg_color: "#111111"
                    
            Image:
                id: logo
                source:'assets/images/logo-trb.png'
                size_hint_x: 0.15
                allow_stretch: True 

			MDBoxLayout:
				orientation: "vertical"
				size_hint_x: 0.7

				MDLabel:
					id: lb_title            
					text: "VEHICLE INSPECTION INTEGRATION MANAGEMENT SYSTEM"
					halign: "left"
					valign: "middle"
					font_style: 'H4'
					theme_text_color: "Custom"
					text_color: "#FFFFFF"


				MDLabel:
					id: lb_subtitle            
					text: "AXLE LOAD & BRAKE METER"
					halign: "left"
					valign: "middle"
					font_style: 'H5'
					theme_text_color: "Custom"
					text_color: "#FFFFFF"

			MDBoxLayout:
				orientation: "vertical"
				size_hint_x: 0.15

				MDLabel:
					id: lb_time
					text: "12:34:00"
					halign: "center"
					valign: "middle"
					font_style: 'H6'
					theme_text_color: "Custom"
					text_color: "#FFFFFF"

				MDLabel:
					id: lb_date
					text: "17/08/2024"
					halign: "center"
					valign: "middle"
					font_style: 'H6'
					theme_text_color: "Custom"
					text_color: "#FFFFFF"

				MDLabel:
					id: lb_operator
					text: "Nama Operator"
					halign: "center"
					valign: "middle"
					font_style: 'H6'
					theme_text_color: "Custom"
					text_color: "#FFFFFF"

				MDLabel:
					id: lb_comm
					text: "Com: Tidak Terhubung"
					halign: "center"
					valign: "middle"
					font_style: 'H6'
					theme_text_color: "Custom"
#----------------------------------------------------------------------------					
# Main Content Layout
        MDBoxLayout:
            padding: dp(15)
            spacing: dp(20)
            size_hint_y: 0.7

            # === PANEL KIRI: TAMPILAN KAMERA ===
            MDBoxLayout:
                orientation: 'horizontal'
                padding: "10dp"
                spacing: "10dp"

                # Kolom Kiri: Tampilan Kamera dan Info Live
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.65
                    spacing: "10dp"
                    MDCard:
                        size_hint_y: 0.8
                        Image:
                            id: camera_view
                            allow_stretch: True
                            fit_mode: 'scale-down'
                    MDCard:
                        orientation: 'vertical'
                        size_hint_y: 0.2
                        padding: "10dp"
                        md_bg_color: app.theme_cls.colors['Gray']['700']
                        MDLabel:
                            id: live_pixel_value
                            text: "Nilai Piksel Mentah: -"
                            halign: "center"
                            font_style: "H6"
                            markup: True
                        MDLabel:
                            id: calibrated_lux_value
                            text: "Lux Terkalibrasi: - lx"
                            halign: "center"
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Primary"
                            markup: True

                # Kolom Kanan: Panel Kontrol Kalibrasi
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_x: 0.35
                    spacing: "10dp"
                    MDCard:
                        orientation: 'vertical'
                        padding: "15dp"
                        spacing: "10dp"
                        MDLabel:
                            text: "Kontrol Kamera"
                            font_style: "H6"
                            halign: "center"
                            padding_y: "10dp"
                        MDLabel:
                            id: exposure_label
                            text: "Exposure: -4"
                            halign: "center"
                            font_style: "Caption"
                        MDSlider:
                            id: exposure_slider
                            min: -10
                            max: -1
                            value: -4
                            step: 1
                            on_value: root.on_exposure_change(self.value)
                        MDLabel:
                            text: "Input Data Kalibrasi"
                            font_style: "H6"
                            halign: "center"
                        MDTextField:
                            id: lux_meter_input
                            hint_text: "Masukkan Nilai dari Luxmeter"
                            helper_text_mode: "on_focus"
                            mode: "rectangle"
                        
                        # Tombol Tambah Data
                        MDRectangleFlatIconButton:
                            icon: "plus"
                            text: "Tambah Data"
                            theme_text_color: "Custom"
                            text_color: "#FFFFFF"
                            md_bg_color: "#4471C4"
                            on_press: root.add_data_point()
                            
                        MDBoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: "120dp"
                            ScrollView:
                                MDLabel:
                                    id: data_log
                                    size_hint_y: None
                                    height: self.texture_size[1]
                                    text_size: self.width, None
                        
                        # Tombol Hitung & Simpan Kalibrasi
                        MDRectangleFlatIconButton:
                            icon: "calculator-variant"
                            text: "Hitung & Simpan Kalibrasi"
                            theme_text_color: "Custom"
                            text_color: "#FFFFFF"
                            md_bg_color: "#04c835ff"
                            on_press: root.calculate_and_save()
                        
                        # Tombol Bersihkan Data
                        MDRectangleFlatIconButton:
                            icon: "delete-sweep"
                            text: "Bersihkan Data"
                            theme_text_color: "Custom"
                            text_color: "#FFFFFF"
                            md_bg_color: "#ff0000ff"
                            on_press: root.clear_data()

                        MDLabel:
                            id: result_slope
                            text: "Hasil Slope: -"
                            font_style: "Body1"
                            markup: True
                        MDLabel:
                            id: result_intercept
                            text: "Hasil Intercept: -"
                            font_style: "Body1"
                            markup: True
                            
                    # Tombol Kembali
                    MDRectangleFlatIconButton:
                        icon: "keyboard-return"
                        text: "Kembali ke Menu Utama"
                        theme_text_color: "Custom"
                        text_color: "#EEEEEE"
                        md_bg_color: "#ff0000ff"
                        size_hint_y: None
                        height: "40dp"
                        on_press: root.exec_navigate_main()

		# footer layout
        MDBoxLayout:
            orientation: "horizontal"
			size_hint_y: 0.1

			MDBoxLayout:
				orientation: "horizontal"
				padding: 20
				spacing: 20
				md_bg_color: "#4471C4"
				size_hint_x: 0.4
				
				AsyncImage:
					id: img_pemkab
					source:'assets/images/logo-sorong.png'
					size_hint_x: 0.1
					allow_stretch: True  

				AsyncImage:
					id: img_dishub
					source:'assets/images/logo-dishub.png'
					size_hint_x: 0.1
					allow_stretch: True  

				MDBoxLayout:
					orientation: "vertical"
					size_hint_x: 0.8

					MDLabel:
						id: lb_pemkab
						text: "PEMERINTAH KABUPATEN SORONG"
						halign: "left"
						valign: "middle"
						theme_text_color: "Custom"
						text_color: "#EEEEEE"						
						font_style: 'Subtitle1'

					MDLabel:
						id: lb_dishub
						text: "DINAS PERHUBUNGAN"
						halign: "left"
						valign: "middle"
						theme_text_color: "Custom"
						text_color: "#EEEEEE"
						font_style: 'Subtitle1'

					MDLabel:
						id: lb_unit			
						text: "UNIT PELAKSANA UJI BERKALA KENDARAAN BERMOTOR"
						halign: "left"
						valign: "middle"
						theme_text_color: "Custom"
						text_color: "#EEEEEE"
						font_style: 'Subtitle1'

					MDLabel:
						id: lb_unit_address
						text: " Klamasen, Distrik Mariat, Kabupaten Sorong, Papua Barat Daya. 98416"
						halign: "left"
						valign: "middle"
						md_bg_color: "#EEEEEE"
						theme_text_color: "Custom"
						text_color: "#000000"
						font_style: 'Subtitle1'

			MDBoxLayout:
				orientation: "vertical"
				padding: 20
				spacing: 20
				md_bg_color: "#FFC000"
				size_hint_x: 0.6

				MDLabel:			
					text: "INFORMASI"
					halign: "left"
					valign: "middle"
					font_style: 'H5'

				MDLabel:
					id: lb_info
					text: "Standar pengujian sesuai PERATURAN MENTERI LINGKUNGAN HIDUP DAN KEHUTANAN REPUBLIK INDONESIA N0 8 TAHUN 2023"
					halign: "left"
					valign: "middle"
					font_style: 'H6'